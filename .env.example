# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Optional client-side Google Maps JavaScript API key.
VITE_GOOGLE_MAPS_API_KEY=""

# VITE_GOOGLE_CLIENT_ID: Google OAuth 2.0 Web Client ID (*.apps.googleusercontent.com) for Google Drive .DOCX sync.
VITE_GOOGLE_CLIENT_ID=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
